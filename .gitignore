# Python 生成文件
__pycache__/
*.py[cod]
build/
dist/
wheels/
*.egg-info

# 虚拟环境
.venv
.venv-dm

# 日志
logs/

# AI 模型权重（.pt/.pth/.ckpt 文件较大，不应提交；.onnx 模型已在 resources/models/ 下按需保留）
*.pt
*.pth
*.ckpt

# 训练数据集（截图样本，体积大）
/data/

# 临时文件
*.tmp
*.bmp
tmp_*

# 例外：resources/images 下的 .bmp 是脚本运行所需的模板图片
!src/GameBot/resources/images/*.bmp

# 运行时日志
*.log

# 环境变量文件（可能含密钥）
.env
.env.*

# IDE 配置
.vscode/*
!.vscode/launch.json
.idea/

# 编辑器临时文件
*.swp
*.swo
*~

# PyInstaller 构建产物
exe/dist/
exe/_extracted/
exe/build/

# 二进制/压缩包
*.exe
*.7z
*.zip
*.pyz
*.dis

# 大漠插件 DLL（外部依赖，不纳入版本控制）
external/dm/*.dll

# Windsurf 本地配置
.windsurf/settings.local.json

# 前端构建产物
src/GameBot/web/dist/
*.tsbuildinfo

# 前端依赖
node_modules/

# Coverage 产物
.coverage
htmlcov/
coverage.xml
*.cover

# pytest 缓存
.pytest_cache/

# mypy 缓存
.mypy_cache/

# ruff 缓存
.ruff_cache/

# Windows 系统文件
Thumbs.db
desktop.ini

# 备份/合并冲突残留
*.bak
*.orig

# 空占位目录
__nonexistent__/

# 测试报告目录（保留在版本控制中，供 Dev/QA 协作）
# docs/test_reports/ — 不忽略，需提交
# docs/review_reports/ — 不忽略，需提交
